rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticatedAdmin() {
      return request.auth != null;
    }

    // -------------------------------------------------------------------------
    // 1. INBOUND ENQUIRIES & BOOKING BRIEFS
    // Anyone on the web can submit a contact form or booking brief.
    // ONLY authenticated admins can view, update status, archive, or delete enquiries.
    // -------------------------------------------------------------------------
    match /enquiries/{enquiryId} {
      // Public visitors can submit (create) inquiries
      allow create: if request.resource.data.name is string 
                    && request.resource.data.email is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.email.size() > 0;

      // Only authenticated studio admin can read, change status, or delete inquiries
      allow read, update, delete: if isAuthenticatedAdmin();
    }

    // -------------------------------------------------------------------------
    // 2. PROJECTS CATALOGUE
    // Anyone on the web can view projects on the portfolio and homepage.
    // ONLY authenticated admins can create, edit, feature, or delete film projects.
    // -------------------------------------------------------------------------
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAuthenticatedAdmin();
    }

    // -------------------------------------------------------------------------
    // 3. CLIENT TESTIMONIALS
    // Anyone on the web can read client reviews.
    // ONLY authenticated admins can add or delete testimonials.
    // -------------------------------------------------------------------------
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAuthenticatedAdmin();
    }

    // -------------------------------------------------------------------------
    // 4. SITE SETTINGS & SOCIAL CHANNELS (settings/site)
    // Anyone on the web can read studio brand info and social links.
    // ONLY authenticated admins can edit studio phone, email, and social handles.
    // -------------------------------------------------------------------------
    match /settings/{settingDoc} {
      allow read: if true;
      allow write: if isAuthenticatedAdmin();
    }

    // -------------------------------------------------------------------------
    // 5. MEDIA ASSETS
    // Public read for stills & master assets; Admin-only write.
    // -------------------------------------------------------------------------
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAuthenticatedAdmin();
    }
  }
}
